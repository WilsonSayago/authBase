  "cards": [
    {
      "dot": "emerald",
      "title": "Camino principal",
      "items": [
        "Login colapsa fallos a ErrInvalidCredentials; Create precede al return",
        "Refresh rota en la misma family_id y emite un nuevo par"
      ]
    },
    {
      "dot": "rose",
      "title": "Replay",
      "items": [
        "Segundo Rotate del mismo hash ⇒ RevokeFamily + ErrInvalidRefresh",
        "Nunca distinguir not-found / consumed / revoked al cliente"
      ]
    }
  ]
