      },
      {
        "id": "replay",
        "label": "Replay",
        "focus": ["rotate", "replay", "deny"],
        "note": "ErrRefreshConsumed ⇒ RevokeFamily y ErrInvalidRefresh público."
      }
    ]
  },
  "lanes": [
    { "id": "client", "label": "Cliente / HTTP" },
    { "id": "authn", "label": "AuthenticationService" },
    { "id": "store", "label": "RefreshTokenStore" }
  ],
  "phases": [
    { "id": "login", "label": "Login", "fromCol": 0, "toCol": 2 },
